{
  "name": "@openfulldive/plugin-roadmap",
  "version": "0.1.0-alpha.0",
  "description": "The Roadmap plugin for OpenFullDive — contributor roadmaps toward the eight full-dive capabilities. Installs as a build-time, exactly version-pinned package.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/RoadmapExplorer.tsx",
    "./server": "./src/search.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite"
  },
  "keywords": [
    "openfulldive",
    "plugin",
    "roadmap"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openfulldive/plugin-api": "0.1.0-alpha.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
